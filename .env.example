# First Rain Brain — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
#
# HOW TO GET BIGIN API CREDENTIALS
# =================================
# 1. Go to https://api-console.zoho.in
# 2. Create a "Server-based Application" (not Self-Client — Self-Client tokens expire in 10 min)
# 3. Redirect URI: https://www.zoho.in/crm/oauth-callback  (any valid URI works for Bigin)
# 4. Scope: ZohoBigin.modules.all,ZohoBigin.settings.READ
# 5. Generate → you get Client ID + Client Secret
# 6. Go through the OAuth consent flow once to get a Refresh Token
#    (use Zoho's grant URL: https://accounts.zoho.in/oauth/v2/auth?...)
# 7. Copy the Refresh Token here — it does NOT expire unless revoked.
#
# DATA_CENTER = 'in' for India-hosted accounts (zohoapis.in / accounts.zoho.in)
# DATA_CENTER = 'com' for US-hosted accounts (zohoapis.com / accounts.zoho.com)
# First Rain uses India hosting → use 'in'

BIGIN_CLIENT_ID=1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BIGIN_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BIGIN_REFRESH_TOKEN=1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BIGIN_DATA_CENTER=in
